# Copy these values into your local .env or Render Environment settings.
# Never commit real secrets to GitHub.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173
PORT=4000

# Razorpay Dashboard -> Account & Settings -> API Keys -> Test Mode
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_with_razorpay_test_secret

# Marketplace payment routing. 1% is a proposed configurable commission.
PLATFORM_COMMISSION_PERCENT=1

# Keep transfers disabled until Razorpay Route is enabled for your account,
# providers are onboarded, and test flows are verified.
RAZORPAY_ROUTE_TRANSFERS_ENABLED=false

# Live transfers require BOTH flags to be true; leave false until explicitly approved.
RAZORPAY_ROUTE_LIVE_TRANSFERS_ENABLED=false
